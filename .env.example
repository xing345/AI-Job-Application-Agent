# ============================================================
# AI Job Agent 环境变量模板
# 复制为 .env 并填入真实值。所有密钥一律放 .env, 不要写进 config.json。
# 代码读取优先级: 显式参数 > 环境变量 > config.json
# ============================================================

# --- LLM API (代码实际读取: src/utils/llm_client.py) ---
OPENAI_API_KEY=your_openai_api_key_here
# OpenAI 兼容服务的模型名与 Base URL。
# 使用 DeepSeek 时: OPENAI_MODEL=deepseek-chat, OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# --- Tavily 职位搜索 (代码实际读取: src/search/job_finder.py / search_pipeline.py) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- IMAP 邮箱监听 (代码实际读取: src/email/email_listener.py 经 agent_orchestrator 传入) ---
# server 示例: imap.qq.com / imap.gmail.com / outlook.office365.com
EMAIL_SERVER=imap.qq.com
EMAIL_USERNAME=your_email@example.com
EMAIL_PASSWORD=your_imap_app_password

# ============================================================
# 以下为 Google Gmail API / Calendar API 相关 (可选, 目前通知链路为实验性)
# 若使用 Gmail API / Google Calendar API 时填写; 纯 IMAP 模式可忽略。
# ============================================================
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here
GMAIL_API_KEY=your_gmail_api_key_here
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token_here

# --- 通知渠道 Webhook (可选) ---
NOTIFICATION_WEBHOOKS_FEISHU=your_feishu_webhook_url_here
NOTIFICATION_WEBHOOKS_WECHAT=your_wechat_webhook_url_here
NOTIFICATION_WEBHOOKS_TELEGRAM=your_telegram_bot_token_here
