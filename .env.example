# ============================================================
# 自动求职 Agent 环境变量（重写版）
# 复制为 .env 并填入真实值。所有密钥一律放 .env，禁止硬编码。
# ============================================================

# --- LLM API（OpenAI 兼容接口）---
OPENAI_API_KEY=your_api_key_here
# 使用 DeepSeek 时: OPENAI_MODEL=deepseek-chat, OPENAI_BASE_URL=https://api.deepseek.com
# 使用智谱时: OPENAI_MODEL=glm-4, OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com

# --- 可选：简历和画像文件路径（也可通过命令行 --resume / --profile 指定）---
RESUME_PATH=data/resume.pdf
USER_PROFILE_PATH=data/user_profile.json
