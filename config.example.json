{
  "tavily_api_key": "",
  "search": {
    "interval_hours": 24,
    "max_results_per_search": 50,
    "use_browser": true,
    "use_company_sites": true,
    "use_tavily_search": false,
    "recruit_type": "campus",
    "max_companies": 5,
    "target_companies": [],
    "sources": [
      "bosszhipin",
      "lagou",
      "liepin",
      "zhaopin",
      "51job"
    ],
    "jd_fetch_limit": 40,
    "max_jobs_per_site": 25,
    "max_list_pages": 4,
    "max_card_clicks": 16,
    "max_api_objects": 200,
    "jd_concurrency": 3,
    "portal_keyword_search": true,
    "nav_advisor": {
      "enabled": true,
      "max_calls_per_search": 4,
      "timeout_s": 25,
      "max_candidates": 6
    }
  },
  "matching": {
    "threshold_score": 70,
    "auto_apply": false,
    "dry_run": false
  },
  "browser": {
    "headless": true,
    "timeout": 30000,
    "max_retries": 3,
    "persist_login": true,
    "user_data_dir": "data/browser_profile",
    "visible_concurrency": 2
  },
  "reflection": {
    "enabled": true,
    "learning_mode": "active"
  },
  "email": {
    "enabled": true,
    "check_interval_minutes": 300,
    "server": "imap.gmail.com",
    "username": "",
    "password": ""
  },
  "llm": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "api_key": "",
    "base_url": "https://api.deepseek.com",
    "temperature": 0.7,
    "max_tokens": 2000
  },
  "paths": {
    "resume": "data/resume.pdf",
    "output": "data/output/",
    "logs": "logs/"
  }
}
